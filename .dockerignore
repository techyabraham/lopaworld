# Build context for docker/*.Dockerfile. Only what `pnpm install` and the app builds need should
# reach the build stage; the runtime stages copy build output, never the context.

# VCS, CI and tooling
.git
.github
.claude
.vscode
.idea

# Dependencies and build output (rebuilt inside the image)
.pnpm-store
node_modules
**/node_modules
**/.next
**/.medusa
**/dist
**/build
**/*.tsbuildinfo
coverage
test-results
playwright-report

# Secrets and local environment files, at any depth
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
**/*.pem
**/*.key

# Local runtime data that must never be baked into an image
apps/storefront/public/media/uploads
apps/medusa/uploads
apps/medusa/static

# Not used by any image build
docs
e2e
seed
playwright.config.ts
docker-compose.yml
coolify.compose.yaml
*.log
