# Copy to .env for local development. Never commit secrets.
DATABASE_URL=postgres://lopaworld:lopaworld@localhost:5432/lopaworld
REDIS_URL=redis://localhost:6379
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PREVIEW_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-after-creating-a-Medusa-publishable-key
# TODO_CONFIRM: set the canonical production origin; required for canonical URLs, sitemap and feed links.
NEXT_PUBLIC_SITE_URL=
# TODO_CONFIRM: analytics remains unloaded until a GA4 property is supplied and the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# TODO_CONFIRM: enable only after the Lopaworld Paystack account and payment channels are approved.
PAYSTACK_SECRET_KEY=replace-with-paystack-test-secret-key
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout/return
PAYSTACK_CHANNELS=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=lopaworld-local
